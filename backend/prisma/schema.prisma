generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  prescriptions Prescription[] @relation("DoctorPrescriptions")
  redeemedPrescriptions Prescription[] @relation("PrescriptionRedeemer")
  refreshTokens RefreshToken[]
  preference   UserPreference?
  preferenceDefaultsUpdated PreferenceDefault[] @relation("PreferenceDefaultUpdatedBy")
}

model Prescription {
  id           String   @id @default(cuid())
  doctorId     String
  patientName  String
  patientEmail String
  medications  String
  notes        String?
  qrPayload    String
  status       String   @default("ACTIVE")
  redeemedAt   DateTime?
  redeemedById String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  doctor       User     @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  redeemedBy   User?    @relation("PrescriptionRedeemer", fields: [redeemedById], references: [id])
  auditLogs    AuditLog[]
  scanLogs     ScanLog[]
  
  @@index([doctorId])
  @@index([patientEmail])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  prescriptionId String
  actorRole      String
  actorId        String?
  action         String
  result         String?
  details        String?
  createdAt      DateTime @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  
  @@index([prescriptionId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  revokedAt  DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model ScanLog {
  id             String   @id @default(cuid())
  prescriptionId String?
  actorId        String
  actorRole      String
  payloadHash    String
  result         String
  reason         String?
  createdAt      DateTime @default(now())
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  
  @@index([prescriptionId])
  @@index([actorId])
  @@index([createdAt])
  @@index([result])
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  auditRefreshEnabled  Boolean  @default(true)
  auditRefreshInterval Int      @default(15000)
  scanRefreshEnabled   Boolean  @default(true)
  scanRefreshInterval  Int      @default(15000)
  scanPinnedVisible    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
}

model PreferenceDefault {
  id                   String   @id
  auditRefreshEnabled  Boolean  @default(true)
  auditRefreshInterval Int      @default(15000)
  scanRefreshEnabled   Boolean  @default(true)
  scanRefreshInterval  Int      @default(15000)
  scanPinnedVisible    Boolean  @default(true)
  updatedById           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  updatedBy            User?    @relation("PreferenceDefaultUpdatedBy", fields: [updatedById], references: [id])
}
